# ---- Database ----
# Async SQLAlchemy URL used by the orchestrator (compose maps timescaledb to host port 5433)
DATABASE_URL=postgresql+asyncpg://vigil:vigil@localhost:5433/vigil

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- Admin auth (dashboard/admin JWT) ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Secret used to sign admin JWTs — generate with: python -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET=dev-secret-do-not-use-in-prod

# ---- LLM triage (Google Gemini, free tier via https://aistudio.google.com/apikey) ----
# Leave empty to disable triage gracefully (NullProvider)
GEMINI_API_KEY=
# Free-tier models: gemini-2.5-flash, gemini-2.5-flash-lite, gemini-2.0-flash
GEMINI_MODEL=gemini-2.5-flash
# Embedding model for runbook retrieval (free tier). Falls back to a local
# deterministic embedder when no API key is set.
GEMINI_EMBED_MODEL=gemini-embedding-001

# ---- Blockchain ledger ----
# false = hash chain + Merkle batches still work, on-chain anchoring skipped
LEDGER_ENABLED=true
# Anvil (local dev chain) inside compose; use a Sepolia RPC URL for testnet demo
CHAIN_RPC_URL=http://localhost:8545
CHAIN_ID=31337
# Anvil's well-known dev account #0 key (safe for local dev ONLY)
LEDGER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# Deterministic first-deploy address on a fresh Anvil chain
LEDGER_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
# Anchor cadence: every N seconds or every M unanchored events, whichever first
LEDGER_BATCH_INTERVAL_SECONDS=300
LEDGER_BATCH_MAX_EVENTS=500

# ---- ML ----
ML_ARTIFACT_DIR=./ml_artifacts
ML_ANOMALY_SCORE_THRESHOLD=-0.15
ML_RESOLVE_AFTER_NORMAL_MINUTES=5

# ---- Agent (vigil-agent container/env) ----
VIGIL_ORCHESTRATOR_URL=http://localhost:8000
VIGIL_AGENT_API_KEY=
VIGIL_AGENT_NAME=local-agent
